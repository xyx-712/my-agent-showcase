# local or demo. Keep Demo values in the backend process environment.
MY_AGENT_MODE=local
# MY_AGENT_DEMO_DATA_DIR=<absolute-path-to-separate-demo-data>
# MY_AGENT_PUBLIC_ORIGIN=https://demo.example.com
# Render uses RENDER_EXTERNAL_URL when MY_AGENT_PUBLIC_ORIGIN is unset.
# MY_AGENT_MODEL=qwen2.5:7b
# MY_AGENT_OLLAMA_URL=http://127.0.0.1:11434
# For Ollama Cloud set MY_AGENT_OLLAMA_URL=https://ollama.com and choose a cloud model.
# Set MY_AGENT_OLLAMA_API_KEY in the hosting platform's secret environment.

# Local RAG for specific document questions; enabled by default.
# Full summaries/version/schedule workflows retain their complete-document path.
# MY_AGENT_RAG_ENABLED=1
# MY_AGENT_EMBEDDING_MODEL=embeddinggemma
# MY_AGENT_EMBEDDING_URL=http://127.0.0.1:11434
# MY_AGENT_EMBEDDING_REVISION=
# General document QA: cosine similarity gate, not a confidence probability.
# MY_AGENT_RAG_MIN_SIMILARITY=0.65
# MY_AGENT_RAG_TOP_K=4
# MY_AGENT_RAG_CHUNK_SIZE=800
# MY_AGENT_RAG_CHUNK_OVERLAP=100
# Default Chroma directory is next to APP_DB; embedded mode requires a single worker.
# MY_AGENT_CHROMA_DIR=./data/local_sessions_chroma
# Shared local Chroma Server for multiple API workers; keep its port private.
# Embedded Chroma still requires one worker. See docs/architecture-stage4-final.md.
# MY_AGENT_CHROMA_URL=http://127.0.0.1:8002

# Cooperative total chat budget, seconds: >0 and <=3600; default 180.
# A synchronous call is allowed to return before timeout finalization.
# MY_AGENT_REQUEST_SECONDS=180
# Authentication session lifetime: 60..2592000 seconds; default seven days.
# MY_AGENT_SESSION_SECONDS=604800

# Optional local OCR executables. Native-text PDF needs neither executable.
# MY_AGENT_TESSERACT=<absolute-path-to-tesseract-executable>
# MY_AGENT_PDFTOPPM=<absolute-path-to-pdftoppm-executable>
# MY_AGENT_OCR_LANG=chi_sim+eng

# Optional SMTP with STARTTLS; no real mail is sent merely by configuration.
# Keep real credentials out of this example and out of Git.
# MY_AGENT_SMTP_HOST=smtp.example.com
# MY_AGENT_SMTP_PORT=587
# MY_AGENT_SMTP_FROM=agent@example.com
# MY_AGENT_SMTP_USER=
# MY_AGENT_SMTP_PASSWORD=

# Unified prompt budget (estimated tokens). Total window <=8192 in this stage.
# Current question/evidence/tool pairs are never silently truncated.
# MY_AGENT_CONTEXT_TOKENS=8192
# MY_AGENT_CONTEXT_RESERVE=4096
# MY_AGENT_CONTEXT_TURNS=5
# MY_AGENT_CONTEXT_MEMORY_TOKENS=512
# Bounded older-dialogue excerpts; same Ollama model, no extra service.
# Recent complete turns remain under MY_AGENT_CONTEXT_TURNS (default 5).
MY_AGENT_SUMMARY_MIN_TURNS=4
MY_AGENT_SUMMARY_BATCH_TURNS=4
MY_AGENT_SUMMARY_TOKENS=640
MY_AGENT_SUMMARY_RETRY_SECONDS=30

# Browser test helper: process environment or PATH; do not use placeholder literally.
# MY_AGENT_TEST_BROWSER=<absolute-path-to-browser-executable>

# Windows local startup: run from project root with --workers 1.
# Local SQLite paths are defined by src/config.py, not MY_AGENT_DEMO_DATA_DIR.
# Demo requires an HTTPS origin without port and preserves Secure Cookie rules.
# Do not reuse browser-test certificates, secrets or runtime databases for publication.
